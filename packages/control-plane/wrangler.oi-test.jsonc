{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oi-test-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "SessionDO" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oi-test-db",
      "database_id": "b59795e5-a911-4bc4-9a03-7fe5fe8a0808"
    }
  ],

  "kv_namespaces": [
    { "binding": "REPOS_CACHE", "id": "47349f835e514ddb9b880b230de16d0b" }
  ],

  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "oi-test-media" }
  ],

  "containers": [
    {
      "class_name": "Sandbox",
      "image": "registry.cloudflare.com/aec793e8d592f57a099b55b31e518f0c/oi-test-sandbox@sha256:6217d2aba15bbc69ba68cc029b0422655c717636ae50e4b1d8103ba8023284d7",
      "max_instances": 40,
      "instance_type": "standard-2"
    }
  ],

  "vars": {
    "SANDBOX_PROVIDER": "cloudflare",
    "SANDBOX_SLEEP_AFTER": "1h",
    "SANDBOX_INACTIVITY_TIMEOUT_MS": "90000",
    "DEPLOYMENT_NAME": "oi-test",
    "APP_NAME": "Open-Inspect Test",
    "GITHUB_BOT_USERNAME": "open-inspect[bot]",
    "ALLOWED_USERS": "",
    "ALLOWED_EMAIL_DOMAINS": "",
    "ALLOWED_EMAILS": "",
    "ALLOWED_GITHUB_ORGS": "StirringMinds",
    "UNSAFE_ALLOW_ALL_USERS": "false",
    "SCM_PROVIDER": "github",
    "LOG_LEVEL": "debug",
    "WORKER_URL": "https://oi-test-control-plane.jayasuriya-brunthan.workers.dev",
    "WEB_APP_URL": "https://oi-test-web.jayasuriya-brunthan.workers.dev",
    "GITHUB_CLIENT_ID": "Iv23liI4kMHiELf1TmMN",
    "CF_ACCOUNT_ID": "aec793e8d592f57a099b55b31e518f0c",
    "CLOUDFLARE_ACCOUNT_ID": "aec793e8d592f57a099b55b31e518f0c"
  },

  "observability": { "enabled": true }
}
